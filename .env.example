# Server-side Content API (used by server components to fetch content)
HYGRAPH_ENDPOINT=https://api-us-east-1-shared-usea1-02.hygraph.com/v2/<projectId>/master
HYGRAPH_TOKEN=

# Exposed to the browser for the Hygraph Preview SDK (click-to-edit).
# Same Content API endpoint as above.
NEXT_PUBLIC_HYGRAPH_ENDPOINT=https://api-us-east-1-shared-usea1-02.hygraph.com/v2/<projectId>/master
# Studio base URL. Default works for app.hygraph.com projects.
NEXT_PUBLIC_HYGRAPH_STUDIO_URL=https://app.hygraph.com
