graph LR
  subgraph BASE["1 - Base - authored once, shared"]
    direction TB
    A1[Shared pages & posts<br/>home - pricing - blog - plans]
    A2[Global defaults<br/>CTA - branding - discount]
  end
  subgraph REGION["2 - Regional - per region<br/>Global / AU / NZ / UK"]
    direction TB
    B1[Locale: en / en_GB]
    B2[Own navbar & footer]
    B3[Own discount %]
    B4[Which content is assigned]
  end
  subgraph ONEOFF["3 - One-off - per-entry exceptions"]
    direction TB
    C1[Discount override<br/>e.g. 95% campaign]
    C2[CTA override<br/>e.g. one-off label]
    C3[Region-only page<br/>/uk/campaign/uk-only]
    C4[Excluded from a region<br/>global-excluded post]
  end
  BASE ==>|region adjusts the defaults| REGION ==>|an entry can break the pattern| ONEOFF

  classDef base fill:#e3f0ff,stroke:#2b6cb0,color:#1a365d;
  classDef region fill:#e6f6ec,stroke:#2f855a,color:#22543d;
  classDef oneoff fill:#fff4e0,stroke:#c05621,color:#7b341e;
  class A1,A2 base;
  class B1,B2,B3,B4 region;
  class C1,C2,C3,C4 oneoff;
